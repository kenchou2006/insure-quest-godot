{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insure-quest",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Godot web build is exported to ../web/insure-quest (mirrors BASE_PATH, see tools/build-web.sh) so static files
  // are matched and served by Workers Static Assets without invoking the Worker (asset requests are free; Worker runs are billed).
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    // Only the API runs the Worker first (OAuth start/callback are browser navigations and must not get the 404 page)
    "run_worker_first": ["/insure-quest/api/*"],
    // Unknown paths get a bare 404 from the asset router; browser navigations to them never invoke the Worker
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "RECORDS", "class_name": "Records" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Records"] }
  ],
  // UTC. Daily 03:00: purge demo accounts older than 7 days. 1st of month 04:00: purge never-played accounts idle 90 days.
  "triggers": {
    "crons": ["0 3 * * *", "0 4 1 * *"]
  },
  // Workers AI (used when AI_PROVIDER=workers-ai); local wrangler dev calls remote, requires wrangler login
  "ai": { "binding": "AI" },
  "vars": {
    // URL prefix when mounted on a Route (e.g. example.com/insure-quest*). "" = serve from root.
    // The Route itself is managed in the Cloudflare dashboard (Domains & Routes) so no domain is hard-coded here.
    "BASE_PATH": "/insure-quest",
    "AI_PROVIDER": "workers-ai",
    "WORKERS_AI_MODEL": "@cf/qwen/qwen3.8-27b",
    "NVIDIA_MODEL": "nvidia/nemotron-3-super-120b-a12b",
    "NVIDIA_FALLBACK_MODEL": "deepseek-ai/deepseek-v4.1-flash",
    "AI_DAILY_LIMIT": "10",
    // NIM chat goes through AI Gateway `nvidia-nim` via the AI binding: dynamic route `nim` (model node = metadata.model)
    // -> custom provider `nvidia-nim` (base_url https://integrate.api.nvidia.com, NIM key stored on the gateway). "" = call NIM directly
    "CF_AIG_GATEWAY_ID": "nvidia-nim",
    "CF_AIG_ROUTE": "nim"
  },
  // Set secrets via wrangler secret put: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, (optional) NVIDIA_API_KEY, TRAINER_EMAILS (comma-separated trainer emails allowed to view all learner records)
  "observability": { "enabled": true },
  // Local dev environment (npm run dev = wrangler dev --env local): Workers AI binding calls remote, requires wrangler login.
  // When offline, set AI_PROVIDER=mock in .dev.vars (overrides vars below).
  // Bindings and vars are not inherited by environments, so re-list Durable Objects and variables here.
  "env": {
    "local": {
      // Local dev serves the build from the root (BASE_PATH ""), so point straight at the prefixed folder
      "assets": {
        "directory": "../web/insure-quest",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" },
          { "name": "RECORDS", "class_name": "Records" }
        ]
      },
      "vars": {
        "BASE_PATH": "",
        "AI_PROVIDER": "workers-ai",
        "WORKERS_AI_MODEL": "@cf/qwen/qwen3.8-27b",
        "NVIDIA_MODEL": "nvidia/nemotron-3-super-120b-a12b",
        "NVIDIA_FALLBACK_MODEL": "deepseek-ai/deepseek-v4.1-flash",
        "AI_DAILY_LIMIT": "10",
        "CF_AIG_GATEWAY_ID": "nvidia-nim",
        "CF_AIG_ROUTE": "nim"
      }
    }
  }
}
