{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insure-quest",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Export Godot web build to ../web; /api/* handled by Worker first, remainder are static assets
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "RECORDS", "class_name": "Records" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Records"] }
  ],
  // Workers AI (used when AI_PROVIDER=workers-ai); local wrangler dev calls remote, requires wrangler login
  "ai": { "binding": "AI" },
  "vars": {
    "AI_PROVIDER": "workers-ai",
    "WORKERS_AI_MODEL": "@cf/qwen/qwen3.8-27b",
    "NVIDIA_MODEL": "nvidia/nemotron-3-super-120b-a12b",
    "NVIDIA_FALLBACK_MODEL": "deepseek-ai/deepseek-v4.1-flash",
    "AI_DAILY_LIMIT": "10"
  },
  // Set secrets via wrangler secret put: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, (optional) NVIDIA_API_KEY, TRAINER_EMAILS (comma-separated trainer emails allowed to view all learner records)
  "observability": { "enabled": true },
  // Local dev environment (npm run dev = wrangler dev --env local): Workers AI binding calls remote, requires wrangler login.
  // When offline, set AI_PROVIDER=mock in .dev.vars (overrides vars below).
  // Bindings and vars are not inherited by environments, so re-list Durable Objects and variables here.
  "env": {
    "local": {
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" },
          { "name": "RECORDS", "class_name": "Records" }
        ]
      },
      "vars": {
        "AI_PROVIDER": "workers-ai",
        "WORKERS_AI_MODEL": "@cf/qwen/qwen3.8-27b",
        "NVIDIA_MODEL": "nvidia/nemotron-3-super-120b-a12b",
        "NVIDIA_FALLBACK_MODEL": "deepseek-ai/deepseek-v4.1-flash",
        "AI_DAILY_LIMIT": "10"
      }
    }
  }
}
